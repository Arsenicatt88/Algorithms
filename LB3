def A():
    mas_A = ['a','b','c','d','e','f','f','f','f','f','f',"21"]
    pod_mas_A = ['b','d','f',"21"]
    slovar_mas_A = {}
    slovar_pod_mas_A = {}
    count_mas = len(pod_mas_A)
    count  = 0

    for i in mas_A:
        slovar_mas_A[i] = mas_A.count(i)
    for i in pod_mas_A:
        slovar_pod_mas_A[i] = pod_mas_A.count(i)

    for i in slovar_pod_mas_A:
        try:
            if slovar_mas_A[i] >= 1:
                count += 1
            
        except KeyError:
            print("множество не является подмножеством")

    if count == count_mas:
        print("Множество является подмножеством")

