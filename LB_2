# --- ЗАМЕРЫ ВРЕМЕНИ ---
start = time.perf_counter()
bubble_sort(small_list.copy())
time_bubble = time.perf_counter() - start

start = time.perf_counter()
insertion_sort(small_list.copy())
time_insertion = time.perf_counter() - start

start = time.perf_counter()
quick_sort(products)
time_quick = time.perf_counter() - start


bubble_sorted = small_list.copy()
bubble_sort(bubble_sorted)

# --- ОТСОРТИРОВАННЫЙ СПИСОК ---
