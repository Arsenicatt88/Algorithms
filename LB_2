import random
import time

print("Генерация 1 000 000 товаров")
products = []
for i in range(1000000):
    product = {"id": random.randint(1, 10000000), "name": "Товар_" + str(i)}
    products.append(product)

print(f"Готово. Пример: {products[:2]}\n")

small_list = products[:10000]


def bubble_sort(lst):
    n = len(lst)
    for i in range(n):
        for j in range(n - 1 - i):
            tovar1 = lst[j]
            tovar2 = lst[j + 1]
            if tovar1["id"] > tovar2["id"]:
                lst[j] = tovar2
                lst[j + 1] = tovar1



def insertion_sort(lst):
    for i in range(1, len(lst)):
        current_tovar = lst[i]
        j = i - 1
        while j >= 0 and current_tovar["id"] < lst[j]["id"]:
            lst[j + 1] = lst[j]
            j -= 1
        lst[j + 1] = current_tovar


def quick_sort(lst):
    if len(lst) <= 1:
        return lst
    pivot = lst[len(lst) // 2]["id"]
    left = []
    middle = []
    right = []
    for tovar in lst:
        if tovar["id"] < pivot:
            left.append(tovar)
        elif tovar["id"] > pivot:
            right.append(tovar)
        else:
            middle.append(tovar)
    return quick_sort(left) + middle + quick_sort(right)


# --- НЕОТСОРТИРОВАННЫЙ СПИСОК ---
print("=" * 60)
print("НЕОТСОРТИРОВАННЫЙ СПИСОК (первые 20):")
